# LLM Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Embedding Configuration
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector Store
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Mock Mode
MOCK_MODE=true

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
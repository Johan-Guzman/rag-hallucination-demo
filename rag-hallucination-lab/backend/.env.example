# LLM Configuration
# mock  = offline demo, no API calls (default)
# gemini = live Google Gemini generation (requires GEMINI_API_KEY)
# This file is the single source of truth for local runs AND Docker Compose
# (the backend service loads it), so changing it here is enough for both.
LLM_PROVIDER=mock
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=gpt-4o-mini

# Google Gemini (only used when LLM_PROVIDER=gemini)
# GEMINI_API_KEY is read by the backend only. It is never sent to the frontend
# and must never be committed. Use a Google AI Studio API key.
GEMINI_API_KEY=
# The model name has a single source of truth in app/core/config.py
# (default: gemini-3.5-flash-lite, verified to have available quota).
# Only set GEMINI_MODEL here to override it; leave it commented to use the default.
# GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.0
GEMINI_MAX_OUTPUT_TOKENS=2048
# Fallback chain: if the primary model fails with "unavailable", each of these
# models is tried in order. Only set GEMINI_FALLBACK_MODELS to override; leave
# it commented to use the defaults.
# GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite,gemini-2.5-flash-lite

# Embedding Configuration
EMBEDDING_PROVIDER=mock
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
SENTENCE_TRANSFORMER_MODEL=all-MiniLM-L6-v2

# Vector Store
# NOTE: the current MOCK_MODE implementation is fully in-memory and does not
# use Chroma. These values are kept for a future real vector store.
VECTOR_STORE=chroma
CHROMA_PERSIST_DIR=./data/chroma

# Knowledge base directory (documents + demo_cases.json)
DATA_DIR=./data

# CORS: comma-separated list of allowed origins, or "*" for any.
# In production, list the exact frontend origin (no trailing slash):
#   CORS_ORIGINS=https://rag-hallucination-demo-front.onrender.com
CORS_ORIGINS=https://rag-hallucination-demo-front.onrender.com,http://localhost:3000,http://127.0.0.1:3000

# Mock Mode ("use real APIs" override)
# LLM_PROVIDER=gemini always wins. Setting MOCK_MODE=false while
# LLM_PROVIDER=mock also enables Gemini (real APIs requested), and fails with a
# clear error if GEMINI_API_KEY is missing. MOCK_MODE=true (or unset with
# LLM_PROVIDER=mock) keeps the offline demo. Unset is recommended so that
# LLM_PROVIDER alone decides.
MOCK_MODE=true

# Server
HOST=0.0.0.0
PORT=8000
DEBUG=true
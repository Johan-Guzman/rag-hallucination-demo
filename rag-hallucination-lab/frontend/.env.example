# Leave NEXT_PUBLIC_API_URL empty to use the same-origin API proxy defined in
# next.config.js. Set it to an absolute URL (e.g. http://localhost:8000) to make
# browser requests hit the backend directly.
NEXT_PUBLIC_API_URL=

# Backend target for the Next.js proxy. Only needed for local development
# against a non-default backend; Docker Compose sets it automatically
# (BACKEND_URL=http://backend:8000). Default fallback is http://localhost:8000.
# BACKEND_URL=http://localhost:8000

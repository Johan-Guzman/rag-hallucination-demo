# Absolute backend base URL for direct browser -> backend calls (LOCAL ONLY).
# Leave EMPTY to use the same-origin API proxy defined in next.config.js
# (recommended; then set BACKEND_URL instead).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time. The
# production Docker build intentionally ignores this variable (it forces it to
# empty) so a stale dashboard value can never break the browser; the deployed
# app always uses the same-origin proxy. Configure the backend with BACKEND_URL.
#
# Local development:
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Do NOT include the "/api" suffix: api.ts appends "/api" itself (a value that
# already ends in "/api" is tolerated, but a bare origin is preferred).
NEXT_PUBLIC_API_URL=

# Backend target for the Next.js same-origin proxy (/api/*). This is the
# production variable to configure on the Render frontend service:
#   BACKEND_URL=https://rag-hallucination-demo-back.onrender.com
# If it is unset, the proxy falls back to the published backend in production
# (NODE_ENV=production) and to http://localhost:8000 ONLY in local development
# (NODE_ENV != production). Docker Compose sets it automatically
# (BACKEND_URL=http://backend:8000).
# BACKEND_URL=http://localhost:8000

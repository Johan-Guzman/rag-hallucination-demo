# ---------------------------------------------------------------------------
# PRODUCTION (Render frontend service)
# ---------------------------------------------------------------------------
# The Next.js same-origin proxy target. THIS IS THE ONLY VARIABLE YOU NEED
# TO SET IN PRODUCTION. Set it to the published Render backend:
#
#   BACKEND_URL=https://rag-hallucination-demo-back.onrender.com
#
# If it is unset, the proxy falls back to the published backend in production
# (NODE_ENV=production) and to http://localhost:8000 ONLY in local development.
# Docker Compose sets it automatically (BACKEND_URL=http://backend:8000).
#
# NOTE: Even if someone sets BACKEND_URL=http://localhost:8000 in the Render
# dashboard, next.config.js detects this in production and replaces it with
# the published backend, so the container can never proxy to itself.
#
# ---------------------------------------------------------------------------
# LOCAL DEVELOPMENT ONLY
# ---------------------------------------------------------------------------
# The production Docker build intentionally forces NEXT_PUBLIC_API_URL to
# empty, so it has no effect on the deployed app. Use it only for local dev
# when you want the browser to call the backend directly (bypassing the proxy):
#
#   NEXT_PUBLIC_API_URL=http://localhost:8000
#
# Do NOT include the "/api" suffix: api.ts appends "/api" itself.
NEXT_PUBLIC_API_URL=

# Backend target for the Next.js same-origin proxy (/api/*). Production:
#   BACKEND_URL=https://rag-hallucination-demo-back.onrender.com
# Local development:
#   BACKEND_URL=http://localhost:8000
